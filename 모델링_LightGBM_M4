"""
=============================================================================
 model_M4_ABC_fixed.py  —  A+B+C 결합 모델(M4) + RQ2 검증 (LightGBM)
 ★ 팀원 지적 3가지 수정 반영 버전
=============================================================================
 실행 :  python model_M4_ABC_fixed.py
 필요 :  pip install pandas numpy scikit-learn lightgbm scipy

 [ 수정된 3가지 문제 ]
   ① 검증 fold 누수 제거
      - 기존: early stopping 기준으로 va(검증fold)를 쓰고 그 va를 예측 → 누수
      - 수정: tr을 다시 나눠 early stopping 전용 검증셋(es)을 tr 내부에서 뽑음.
              va는 오직 예측(채점)에만 사용 → 누수 없음
   ② scale_pos_weight 통일
      - 로지스틱이 class_weight='balanced'였다면 기법 간 처리를 맞춰야 공정.
      - USE_SCALE_POS_WEIGHT 스위치로 켜고 끔. AUC(순위지표)가 목적이면
        기본 False 권장(양쪽 다 보정 안 함으로 통일). 확률 캘리브레이션이
        목적이면 True로 켜고 로지스틱도 balanced 유지.
   ③ importance_type='gain' 명시
      - 기본값 split이 아니라 gain으로 고정 (해석 일관성)

 [ 모델 정의 ]
   M3 = A + B       (기준)
   M4 = A + B + C   (신규비금융 추가)
   RQ2 = M4 vs M3 의 ΔAUC + DeLong 검정
=============================================================================
"""

import warnings
import numpy as np
import pandas as pd
from sklearn.model_selection import StratifiedKFold, train_test_split
from sklearn.metrics import roc_auc_score
from pandas.api.types import is_numeric_dtype
from scipy import stats
import lightgbm as lgb

warnings.filterwarnings("ignore")

# ==================== 설정 ====================
FILE_A = "model_A_financial_final.csv"
FILE_B = "model_B_nonfinancial_final.csv"
FILE_C = "model_C_nonfinancial_new_final.csv"
N_FOLDS = 5
SAMPLE_N = None          # None=전체, 빠른 테스트 150000
RANDOM_STATE = 42
EARLY_STOP = 80
ES_SIZE = 0.2            # tr에서 early stopping 검증셋으로 뗄 비율
USE_SCALE_POS_WEIGHT = False   # ② 기법 간 통일용 스위치 (AUC 목적이면 False 권장)
TREE_PARAMS = dict(n_estimators=1000, learning_rate=0.02, num_leaves=31,
                   colsample_bytree=0.8, subsample=0.9, subsample_freq=1,
                   reg_lambda=1.0, min_child_samples=100, verbose=-1, n_jobs=-1,
                   importance_type="gain")   # ③ gain 명시
ID, TARGET = "SK_ID_CURR", "TARGET"


# ==================== 로드 & 병합 ====================
def load_abc():
    A = pd.read_csv(FILE_A); B = pd.read_csv(FILE_B); C = pd.read_csv(FILE_C)
    a_cols = [c for c in A.columns if c not in (ID, TARGET)]
    b_cols = [c for c in B.columns if c not in (ID, TARGET)]
    c_cols = [c for c in C.columns if c not in (ID, TARGET)]
    df = A.merge(B[[ID] + b_cols], on=ID, how="inner")
    df = df.merge(C[[ID] + c_cols], on=ID, how="inner")
    for c in df.columns:
        if df[c].dtype == bool:
            df[c] = df[c].astype(int)
    drop = [c for c in df.columns
            if c not in (ID, TARGET) and not is_numeric_dtype(df[c])]
    if drop:
        print(f"  비수치 컬럼 제외: {drop}")
    a_cols = [c for c in a_cols if c not in drop]
    b_cols = [c for c in b_cols if c not in drop]
    c_cols = [c for c in c_cols if c not in drop]
    return df, a_cols, b_cols, c_cols


# ==================== DeLong ====================
def _mr(x):
    J = np.argsort(x); Z = x[J]; N = len(x); T = np.zeros(N); i = 0
    while i < N:
        j = i
        while j < N and Z[j] == Z[i]:
            j += 1
        T[i:j] = 0.5 * (i + j - 1) + 1; i = j
    o = np.empty(N); o[J] = T
    return o


def delong(y, s1, s2):
    """반환: (ΔAUC = AUC(s1)-AUC(s2), p_value)"""
    y = np.asarray(y); od = (-y).argsort(kind="mergesort"); m = int(y.sum())
    p = np.vstack([np.asarray(s1)[od], np.asarray(s2)[od]]); n = p.shape[1] - m
    tx = np.vstack([_mr(p[r, :m]) for r in range(2)])
    ty = np.vstack([_mr(p[r, m:]) for r in range(2)])
    tz = np.vstack([_mr(p[r, :]) for r in range(2)])
    a = tz[:, :m].sum(1) / m / n - (m + 1) / 2 / n
    cov = np.cov((tz[:, :m] - tx) / n) / m + np.cov(1 - (tz[:, m:] - ty) / m) / n
    l = np.array([[1, -1]])
    v = float(np.asarray(l @ np.atleast_2d(cov) @ l.T).ravel()[0])
    dl = float(a[0] - a[1])
    if v <= 0:
        return dl, (1.0 if abs(dl) < 1e-12 else np.nan)
    z = dl / np.sqrt(v)
    return dl, float(2 * (1 - stats.norm.cdf(abs(z))))


# ==================== 교차검증 (누수 없는 버전) ====================
def cv_tree(df, y, cols, folds, spw=None):
    """
    ① 누수 제거 핵심:
       - tr을 tr_in(학습) + es_in(early stopping 검증)으로 다시 분리
       - early stopping은 es_in으로만 판단
       - va(진짜 검증 fold)는 예측에만 사용, 학습·조기종료에 절대 안 씀
    """
    X = df[cols].replace([np.inf, -np.inf], np.nan)
    oof = np.zeros(len(y)); imps = []
    fold_aucs = []
    for k, (tr, va) in enumerate(folds, 1):
        # tr 내부에서 early stopping용 검증셋 분리 (va는 건드리지 않음)
        tr_in, es_in = train_test_split(
            tr, test_size=ES_SIZE, random_state=RANDOM_STATE + k,
            stratify=y[tr])
        params = dict(TREE_PARAMS)
        if spw is not None:
            params["scale_pos_weight"] = spw     # ② 통일 스위치
        m = lgb.LGBMClassifier(**params, random_state=RANDOM_STATE + k)
        m.fit(X.iloc[tr_in], y[tr_in],
              eval_set=[(X.iloc[es_in], y[es_in])], eval_metric="auc",
              callbacks=[lgb.early_stopping(EARLY_STOP, verbose=False)])
        pred_va = m.predict_proba(X.iloc[va])[:, 1]
        oof[va] = pred_va
        fold_aucs.append(roc_auc_score(y[va], pred_va))   # fold별 AUC (안정성)
        imps.append(pd.Series(m.feature_importances_, index=cols))
    return (oof, roc_auc_score(y, oof),
            pd.concat(imps, axis=1).mean(axis=1), np.array(fold_aucs))


# ==================== 메인 ====================
def main():
    print("A + B + C 로드 & 병합...")
    df, A, B, C = load_abc()
    if SAMPLE_N:
        df = df.sample(SAMPLE_N, random_state=1).reset_index(drop=True)
    y = df[TARGET].values
    spw = ((y == 0).sum() / (y == 1).sum()) if USE_SCALE_POS_WEIGHT else None
    print(f"  {len(df):,}행, 부도율 {y.mean():.2%}")
    print(f"  A(금융) {len(A)} / B(전통비금융) {len(B)} / C(신규비금융) {len(C)}")
    print(f"  누수제거: ON | scale_pos_weight: "
          f"{'ON('+format(spw,'.2f')+')' if spw else 'OFF'} | importance: gain\n")

    m3_cols = A + B
    m4_cols = A + B + C
    folds = list(StratifiedKFold(N_FOLDS, shuffle=True,
                                 random_state=RANDOM_STATE).split(df, y))

    oof3, auc3, _,   f3 = cv_tree(df, y, m3_cols, folds, spw)
    oof4, auc4, imp4, f4 = cv_tree(df, y, m4_cols, folds, spw)
    d, p = delong(y, oof4, oof3)
    fold_delta = f4 - f3

    print("=" * 64)
    print(f"M3 (A+B)   n={len(m3_cols):3d}  AUC={auc3:.5f}  (fold편차 {f3.std():.5f})")
    print(f"M4 (A+B+C) n={len(m4_cols):3d}  AUC={auc4:.5f}  (fold편차 {f4.std():.5f})")
    print("-" * 64)
    print(f"RQ2: C(신규비금융)의 추가 기여")
    print(f"     ΔAUC={d:+.5f}  (fold편차 {fold_delta.std():.5f})  "
          f"DeLong p={p:.3e}  {'유의' if p < 0.05 else '비유의'}")
    print("=" * 64)

    # 저장
    pd.DataFrame([
        {"모델": "M3_A+B", "변수수": len(m3_cols), "AUC": round(auc3, 5),
         "fold표준편차": round(f3.std(), 5)},
        {"모델": "M4_A+B+C", "변수수": len(m4_cols), "AUC": round(auc4, 5),
         "fold표준편차": round(f4.std(), 5)},
    ]).to_csv("results_M4_fixed.csv", index=False, encoding="utf-8-sig")
    pd.DataFrame([
        {"비교": "RQ2 (M4-M3) 신규비금융 추가기여", "ΔAUC": round(d, 5),
         "ΔAUC_fold표준편차": round(fold_delta.std(), 5),
         "DeLong_p": p, "유의성": "유의" if p < 0.05 else "비유의"},
    ]).to_csv("delong_M4_fixed.csv", index=False, encoding="utf-8-sig")

    grp = {**{c: "A_금융" for c in A}, **{c: "B_전통비금융" for c in B},
           **{c: "C_신규비금융" for c in C}}
    imp_df = pd.DataFrame({"변수": imp4.index,
                           "군": [grp[c] for c in imp4.index],
                           "중요도_gain": imp4.values})
    imp_df = imp_df.sort_values("중요도_gain", ascending=False).reset_index(drop=True)
    imp_df.to_csv("importance_M4_ABC_fixed.csv", index=False, encoding="utf-8-sig")

    print("\n저장: results_M4_fixed.csv, delong_M4_fixed.csv, "
          "importance_M4_ABC_fixed.csv")
    print("\nM4 변수중요도(gain) 상위 12:")
    print(imp_df.head(12).to_string(index=False))
    c_rank = imp_df[imp_df.군 == "C_신규비금융"].index.min() + 1
    print(f"\nC군(신규비금융) 최고 순위: {c_rank}위")


if __name__ == "__main__":
    main()
