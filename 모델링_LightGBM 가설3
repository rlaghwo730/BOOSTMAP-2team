"""
=============================================================================
 social_by_age_thin.py
 연령대(10세 단위) × 씬파일러 여부로 사회연결망 데이터 효과를 교차 분석
=============================================================================
 실행 :  python social_by_age_thin.py
 필요 :  pip install pandas numpy scikit-learn lightgbm scipy
 입력 :  같은 폴더에 model_A/B/C_*.csv

 [ 검증 방법 ]
   각 (연령대 × 씬파일러 여부) 칸에서:
     기준모델   = A + B + (C에서 사회연결망 제외)
     +사회망모델 = 기준 + 사회연결망 3개
     ΔAUC = 사회연결망의 추가 기여
   → 어느 칸(어느 연령대·이력유무)에서 사회연결망이 가장 유효한지 본다.

 [ 모델 ]  LightGBM, 3-fold(빠름)/5-fold(최종), DeLong 검정
 출력 : social_by_age_thin.csv
=============================================================================
"""

import warnings
import numpy as np
import pandas as pd
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from pandas.api.types import is_numeric_dtype
from scipy import stats
import lightgbm as lgb

warnings.filterwarnings("ignore")

# ==================== 설정 ====================
FILE_A = "model_A_financial_final.csv"
FILE_B = "model_B_nonfinancial_final.csv"
FILE_C = "model_C_nonfinancial_new_final.csv"
N_FOLDS = 5            # 최종 보고용 5-fold
RANDOM_STATE = 42
MIN_N, MIN_BAD = 1500, 60      # 교차 칸은 표본이 작으니 기준 완화
TREE_PARAMS = dict(n_estimators=400, learning_rate=0.03, num_leaves=31,
                   colsample_bytree=0.8, subsample=0.9, subsample_freq=1,
                   reg_lambda=1.0, min_child_samples=60, verbose=-1, n_jobs=-1)
ID, TARGET = "SK_ID_CURR", "TARGET"
SOCIAL = ["OBS_30_CNT_SOCIAL_CIRCLE", "DEF_30_CNT_SOCIAL_CIRCLE",
          "SOCIAL_CIRCLE_MISSING_FLAG"]


# ==================== 로드 ====================
def load():
    A = pd.read_csv(FILE_A); B = pd.read_csv(FILE_B); C = pd.read_csv(FILE_C)
    a = [c for c in A.columns if c not in (ID, TARGET)]
    b = [c for c in B.columns if c not in (ID, TARGET)]
    c = [c for c in C.columns if c not in (ID, TARGET)]
    df = A.merge(B[[ID] + b], on=ID).merge(C[[ID] + c], on=ID)
    for col in df.columns:
        if df[col].dtype == bool:
            df[col] = df[col].astype(int)
    drop = [col for col in df.columns
            if col not in (ID, TARGET) and not is_numeric_dtype(df[col])]
    a = [x for x in a if x not in drop]
    b = [x for x in b if x not in drop]
    c = [x for x in c if x not in drop]
    social = [x for x in SOCIAL if x in df.columns]
    base = a + b + [x for x in c if x not in social]
    return df, base, social


# ==================== DeLong ====================
def _mr(x):
    J = np.argsort(x); Z = x[J]; N = len(x); T = np.zeros(N); i = 0
    while i < N:
        j = i
        while j < N and Z[j] == Z[i]:
            j += 1
        T[i:j] = 0.5 * (i + j - 1) + 1; i = j
    o = np.empty(N); o[J] = T
    return o


def delong(y, s1, s2):
    y = np.asarray(y); od = (-y).argsort(kind="mergesort"); m = int(y.sum())
    p = np.vstack([np.asarray(s1)[od], np.asarray(s2)[od]]); n = p.shape[1] - m
    tx = np.vstack([_mr(p[r, :m]) for r in range(2)])
    ty = np.vstack([_mr(p[r, m:]) for r in range(2)])
    tz = np.vstack([_mr(p[r, :]) for r in range(2)])
    a = tz[:, :m].sum(1) / m / n - (m + 1) / 2 / n
    cov = np.cov((tz[:, :m] - tx) / n) / m + np.cov(1 - (tz[:, m:] - ty) / m) / n
    l = np.array([[1, -1]])
    v = float(np.asarray(l @ np.atleast_2d(cov) @ l.T).ravel()[0])
    dl = float(a[0] - a[1])
    if v <= 0:
        return dl, (1.0 if abs(dl) < 1e-12 else np.nan)
    return dl, float(2 * (1 - stats.norm.cdf(abs(dl / np.sqrt(v)))))


# ==================== 한 칸 분석 ====================
def analyze(sub, name, base, social, rows):
    y = sub[TARGET].values
    if len(sub) < MIN_N or y.sum() < MIN_BAD:
        print(f"  {name:22s} 표본부족 (n={len(sub)}, 부도={int(y.sum())})")
        rows.append({"집단": name, "표본수": len(sub), "부도율": round(y.mean(), 4)
                     if len(sub) else np.nan, "기준AUC": None, "사회망추가AUC": None,
                     "사회망_ΔAUC": None, "DeLong_p": None, "유의성": "표본부족"})
        return
    folds = list(StratifiedKFold(N_FOLDS, shuffle=True,
                                 random_state=RANDOM_STATE).split(sub, y))

    def cv(cols):
        X = sub[cols].replace([np.inf, -np.inf], np.nan)
        oof = np.zeros(len(y))
        for tr, va in folds:
            m = lgb.LGBMClassifier(**TREE_PARAMS).fit(X.iloc[tr], y[tr])
            oof[va] = m.predict_proba(X.iloc[va])[:, 1]
        return oof

    oof_base = cv(base)                 # 사회연결망 없음
    oof_soc = cv(base + social)         # 사회연결망 추가
    a0 = roc_auc_score(y, oof_base)
    a1 = roc_auc_score(y, oof_soc)
    d, p = delong(y, oof_soc, oof_base)
    sig = "유의" if (p == p and p < 0.05) else "비유의"
    print(f"  {name:22s} n={len(sub):6d} 부도율={y.mean():.1%}  "
          f"기준={a0:.4f} +사회망={a1:.4f}  ΔAUC={d:+.4f} p={p:.1e} {sig}")
    rows.append({"집단": name, "표본수": len(sub), "부도율": round(y.mean(), 4),
                 "기준AUC": round(a0, 4), "사회망추가AUC": round(a1, 4),
                 "사회망_ΔAUC": round(d, 5), "DeLong_p": p, "유의성": sig})


# ==================== 메인 ====================
def main():
    df, base, social = load()
    thin = df.BUREAU_NO_HISTORY_FLAG
    age = df.AGE
    df["_decade"] = (age // 10 * 10).astype(int)   # 20,30,40,50,60
    decades = sorted(df["_decade"].unique())

    print(f"전체 {len(df):,}행 | 기준변수 {len(base)}개 | 사회연결망 {len(social)}개\n")
    print("연령대 × 씬파일러 여부 — 사회연결망 데이터의 추가 기여 (ΔAUC)")
    print("=" * 92)

    rows = []
    for dec in decades:
        label = f"{dec}대"
        print(f"\n[{label}]")
        # 씬파일러 / 이력있음 각각
        analyze(df[(df._decade == dec) & (thin == 1)],
                f"{label}·씬파일러", base, social, rows)
        analyze(df[(df._decade == dec) & (thin == 0)],
                f"{label}·이력있음", base, social, rows)
    print("=" * 92)

    R = pd.DataFrame(rows)
    R.to_csv("social_by_age_thin.csv", index=False, encoding="utf-8-sig")
    print("\n저장: social_by_age_thin.csv")

    # 피벗 표 (연령대 × 씬파일러) — ΔAUC만
    print("\n[요약 피벗] 사회연결망 ΔAUC (행=연령대, 열=이력유무)")
    valid = R[R.사회망_ΔAUC.notna()].copy()
    if len(valid):
        valid["연령대"] = valid.집단.str.split("·").str[0]
        valid["유형"] = valid.집단.str.split("·").str[1]
        pv = valid.pivot(index="연령대", columns="유형", values="사회망_ΔAUC")
        print(pv.to_string())


if __name__ == "__main__":
    main()
