"""
=============================================================================
 model_M1_M3.py  —  M1~M3 신용평가 모델링 (LightGBM)
=============================================================================
 실행 :  python model_M1_M3.py
 필요 :  pip install pandas numpy scikit-learn lightgbm scipy
 입력 :  같은 폴더에 3개 파일
           model_A_financial_final.csv       (금융 + bureau)
           model_B_nonfinancial_final.csv     (전통 비금융)
           model_C_nonfinancial_new_final.csv (신규 비금융)

 [ 모델 정의 ]
   M1 = A       금융만 (베이스라인)
   M2 = B       비금융 단독 (참고치, RQ 직접검증용 아님)
   M3 = A + B   금융 + 비금융  → RQ1: 비금융을 더하면 예측력이 오르는가
   (C 신규 비금융을 넣는 M4는 다음 단계에서 추가)

 [ 판정 지표 ]
   - AUC           : 각 모델의 예측력
   - ΔAUC          : M3 - M1 (비금융을 더했을 때의 상승폭)
   - DeLong 검정 p : 그 상승이 통계적으로 유의한가 (p<0.05면 유의)

 [ 특징 ]
   - 세 파일을 SK_ID_CURR 기준으로 병합
   - LightGBM: 결측 그대로, 원본금액 그대로 넣어도 됨 (다중공선성에 강건)
   - 5-fold 교차검증, 모든 모델이 같은 fold 사용 (데이터 차이만 측정)

 출력 : results_M1_M3.csv        (M1/M2/M3 AUC 표)
        delong_M1_M3.csv         (RQ1/RQ2 유의성 검정)
        importance_M3.csv        (M3 변수중요도)
=============================================================================
"""

import warnings
import numpy as np
import pandas as pd
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from scipy import stats
import lightgbm as lgb

warnings.filterwarnings("ignore")

# ==================== 설정 ====================
FILE_A = "model_A_financial_final.csv"
FILE_B = "model_B_nonfinancial_final.csv"
FILE_C = "model_C_nonfinancial_new_final.csv"
N_FOLDS = 5          # 최종 5, 빠른 테스트 3
SAMPLE_N = None      # None=전체 30만, 빠른 테스트는 150000
RANDOM_STATE = 42
TREE_PARAMS = dict(n_estimators=1000, learning_rate=0.02, num_leaves=31,
                   colsample_bytree=0.8, subsample=0.9, subsample_freq=1,
                   reg_lambda=1.0, min_child_samples=100, verbose=-1, n_jobs=-1)
EARLY_STOP = 80
ID, TARGET = "SK_ID_CURR", "TARGET"


# ==================== 데이터 로드 & 병합 ====================
def load_and_merge():
    A = pd.read_csv(FILE_A)
    B = pd.read_csv(FILE_B)
    C = pd.read_csv(FILE_C)

    # 각 파일의 변수 목록 (ID, TARGET 제외)
    a_cols = [c for c in A.columns if c not in (ID, TARGET)]
    b_cols = [c for c in B.columns if c not in (ID, TARGET)]
    c_cols = [c for c in C.columns if c not in (ID, TARGET)]

    # SK_ID_CURR 기준 병합 (B, C는 TARGET 중복이라 변수만 붙임)
    df = A.merge(B[[ID] + b_cols], on=ID, how="inner")
    df = df.merge(C[[ID] + c_cols], on=ID, how="inner")

    # bool 컬럼을 정수로 변환 (C파일의 True/False)
    for c in df.columns:
        if df[c].dtype == bool:
            df[c] = df[c].astype(int)

    # 문자열/비수치 컬럼 제외 (AGE_BAND 등 파생 — 원본 AGE가 이미 있음)
    # LightGBM은 int/float/bool만 받으므로 수치가 아닌 컬럼은 변수군에서 뺀다.
    # object뿐 아니라 pandas StringDtype("str"), category 등도 걸러야 하므로
    # is_numeric_dtype로 판정한다.
    from pandas.api.types import is_numeric_dtype
    drop_nonnum = [c for c in df.columns
                   if c not in (ID, TARGET) and not is_numeric_dtype(df[c])]
    if drop_nonnum:
        print(f"  비수치 컬럼 제외: {drop_nonnum}")
    a_cols = [c for c in a_cols if c not in drop_nonnum]
    b_cols = [c for c in b_cols if c not in drop_nonnum]
    c_cols = [c for c in c_cols if c not in drop_nonnum]

    return df, a_cols, b_cols, c_cols


# ==================== DeLong 검정 ====================
def _mr(x):
    J = np.argsort(x); Z = x[J]; N = len(x); T = np.zeros(N); i = 0
    while i < N:
        j = i
        while j < N and Z[j] == Z[i]:
            j += 1
        T[i:j] = 0.5 * (i + j - 1) + 1; i = j
    o = np.empty(N); o[J] = T
    return o


def delong(y, s1, s2):
    """반환: (ΔAUC = AUC(s1)-AUC(s2), p_value)"""
    y = np.asarray(y); od = (-y).argsort(kind="mergesort"); m = int(y.sum())
    p = np.vstack([np.asarray(s1)[od], np.asarray(s2)[od]]); n = p.shape[1] - m
    tx = np.vstack([_mr(p[r, :m]) for r in range(2)])
    ty = np.vstack([_mr(p[r, m:]) for r in range(2)])
    tz = np.vstack([_mr(p[r, :]) for r in range(2)])
    a = tz[:, :m].sum(1) / m / n - (m + 1) / 2 / n
    cov = np.cov((tz[:, :m] - tx) / n) / m + np.cov(1 - (tz[:, m:] - ty) / m) / n
    l = np.array([[1, -1]])
    v = float(np.asarray(l @ np.atleast_2d(cov) @ l.T).ravel()[0])
    dl = float(a[0] - a[1])
    if v <= 0:
        return dl, (1.0 if abs(dl) < 1e-12 else np.nan)
    z = dl / np.sqrt(v)
    return dl, float(2 * (1 - stats.norm.cdf(abs(z))))


# ==================== 교차검증 (LightGBM) ====================
def cv_tree(df, y, cols, folds):
    X = df[cols].replace([np.inf, -np.inf], np.nan)
    oof = np.zeros(len(y)); imps = []
    for k, (tr, va) in enumerate(folds, 1):
        m = lgb.LGBMClassifier(**TREE_PARAMS, random_state=RANDOM_STATE + k)
        m.fit(X.iloc[tr], y[tr], eval_set=[(X.iloc[va], y[va])], eval_metric="auc",
              callbacks=[lgb.early_stopping(EARLY_STOP, verbose=False)])
        oof[va] = m.predict_proba(X.iloc[va])[:, 1]
        imps.append(pd.Series(m.feature_importances_, index=cols))
    return oof, roc_auc_score(y, oof), pd.concat(imps, axis=1).mean(axis=1)


# ==================== 메인 ====================
def main():
    print("데이터 로드 & 병합...")
    df, A, B, C = load_and_merge()
    if SAMPLE_N:
        df = df.sample(SAMPLE_N, random_state=1).reset_index(drop=True)
    y = df[TARGET].values
    print(f"  병합 완료: {len(df):,}행, 부도율 {y.mean():.2%}")
    print(f"  A(금융) {len(A)} / B(전통비금융) {len(B)} / C(신규비금융) {len(C)}\n")

    # 모델 정의
    #   M1 = A       금융 베이스라인
    #   M2 = B       비금융 단독 (참고치, RQ 직접검증 아님)
    #   M3 = A + B   결합 → RQ1 검증
    specs = {
        "M1_금융":       A,
        "M2_비금융단독":  B,
        "M3_금융+비금융": A + B,
    }
    folds = list(StratifiedKFold(N_FOLDS, shuffle=True,
                                 random_state=RANDOM_STATE).split(df, y))

    oof, auc, imp = {}, {}, {}
    for name, cols in specs.items():
        oof[name], auc[name], imp[name] = cv_tree(df, y, cols, folds)
        print(f"  {name:20s} n={len(cols):3d}  AUC={auc[name]:.5f}")

    # RQ1 검정: M3(A+B) vs M1(A) — 비금융을 더하면 오르는가
    d1, p1 = delong(y, oof["M3_금융+비금융"], oof["M1_금융"])
    print("\n" + "=" * 60)
    print(f"RQ1 (M3 vs M1) 비금융 추가효과   ΔAUC={d1:+.5f}  p={p1:.2e}  "
          f"{'유의' if p1 < 0.05 else '비유의'}")
    print(f"참고: M2(비금융단독) AUC={auc['M2_비금융단독']:.5f} "
          f"— 비금융만으로의 예측력 (비교 기준 아님)")
    print("=" * 60)

    # 저장
    pd.DataFrame([{"모델": n, "변수수": len(specs[n]), "AUC": round(auc[n], 5)}
                  for n in specs]).to_csv("results_M1_M3.csv", index=False,
                                          encoding="utf-8-sig")
    pd.DataFrame([
        {"비교": "RQ1 (M3-M1) 비금융 추가효과", "ΔAUC": round(d1, 5), "DeLong_p": p1},
    ]).to_csv("delong_M1_M3.csv", index=False, encoding="utf-8-sig")
    imp["M3_금융+비금융"].sort_values(ascending=False).to_csv(
        "importance_M3.csv", encoding="utf-8-sig")

    print("\n저장: results_M1_M3.csv, delong_M1_M3.csv, importance_M3.csv")
    print("\nM3 변수중요도 상위 10:")
    print(imp["M3_금융+비금융"].sort_values(ascending=False).head(10).round(0).to_string())


if __name__ == "__main__":
    main()
